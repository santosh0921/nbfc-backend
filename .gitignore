.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/
/android/app/build/
/android/.gradle/
*.apk
*.aab

# Secrets — NEVER commit. Contains JWT signing secrets, PAN encryption
# key, admin credentials, Surepass bearer token, DB password.
.env
.env.*
!.env.example

# Compiled Go binaries / local backend artifacts
/bin/
*.exe
*.exe~
nbfc.db
*.db

# Claude Code / agent tooling local config — not part of the app.
.claude/

# Debug screenshots pulled from the device during troubleshooting.
*_screenshot.png
