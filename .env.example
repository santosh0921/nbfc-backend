APP_NAME=NBFC Backend
APP_PORT=8080
PORT=8080
GIN_MODE=release

# development | sandbox | production — see internal/config.ValidateProductionSafety.
# Production refuses to start with DEMO_MODE=true or missing encryption/provider secrets.
APP_ENV=development
DEMO_MODE=true

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_this_db_password
DB_NAME=nbfc_db
# "disable" for local Postgres without SSL configured; managed Postgres
# (Render, RDS, etc.) generally requires "require".
DB_SSLMODE=disable

JWT_SECRET=change_this_to_a_long_random_secret

# Base64-encoded 32-byte AES-256 key used to encrypt PAN numbers at rest
# (internal/security/crypto.go). Generate one with `openssl rand -base64 32`.
PAN_ENCRYPTION_KEY=change_this_to_a_generated_base64_32_byte_key

# Base64-encoded 32-byte AES-256 key used to encrypt KYC documents at rest
# (internal/storage/local_encrypted.go) — deliberately a SEPARATE key from
# PAN_ENCRYPTION_KEY. Generate with `openssl rand -base64 32`.
DOCUMENT_ENCRYPTION_KEY=change_this_to_a_different_generated_base64_32_byte_key
# Filesystem path documents are encrypted into — must not be inside any
# public web root. Defaults to ./storage/documents if unset.
DOCUMENT_STORAGE_PATH=./storage/documents

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password
ADMIN_JWT_SECRET=change_this_to_a_different_long_random_secret

# Must be different from JWT_SECRET and ADMIN_JWT_SECRET so tokens for the
# three roles can never be interchanged. The app now refuses to start if
# this (or either secret above) is unset — see internal/employee/jwt.go.
EMPLOYEE_JWT_SECRET=change_this_to_a_third_different_long_random_secret

# Alternative to ADMIN_USERNAME/ADMIN_PASSWORD for first-boot admin
# creation — see internal/admin/bootstrap.go. Prefer this over
# ADMIN_USERNAME/ADMIN_PASSWORD in production; rotate the password
# immediately after first login.
ADMIN_BOOTSTRAP_USERNAME=change_this
ADMIN_BOOTSTRAP_EMAIL=change_this@example.com
ADMIN_BOOTSTRAP_PASSWORD=change_this_to_a_strong_password

SUREPASS_BASE_URL=https://sandbox.surepass.app
SUREPASS_BEARER_TOKEN=change_this_to_your_surepass_bearer_token

# Razorpay payment gateway (Phase 2) — leave unset to disable online EMI
# payment (fails closed, never a fake success). All three must be set
# together.
RAZORPAY_KEY_ID=change_this
RAZORPAY_KEY_SECRET=change_this
RAZORPAY_WEBHOOK_SECRET=change_this

# NBFC's registered-office state — drives the intra-state (CGST+SGST) vs
# inter-state (IGST) processing-fee GST split. Defaults to Maharashtra if
# unset — see internal/loans/gst.go.
COMPANY_STATE=Maharashtra

# Comma-separated list of allowed browser origins for CORS (e.g.
# https://admin.example.com,https://app.example.com). Leave unset in
# development only — production refusal to start without this is enforced
# by internal/config.ValidateProductionSafety (Phase 7). Never use "*" for
# an authenticated production API.
CORS_ALLOWED_ORIGINS=

# Comma-separated list of trusted upstream proxy IPs/CIDRs Gin should
# trust for client-IP resolution (X-Forwarded-For) — required for
# rate-limiting and audit-log IP attribution to be accurate behind a
# load balancer/reverse proxy. Leave unset to trust no proxies (direct
# connections only).
TRUSTED_PROXIES=

# --- Export resource limits (Phase 16 item AK) ---
# Bound how much work a single report export may consume. The Phase 9
# rate limiter bounds export FREQUENCY; these bound export SIZE and COST,
# which is a different failure mode. All are optional — the defaults
# shown are used when unset.
#
# Maximum rows in one export (default 200000). An over-limit export is
# refused at request time, not queued and silently failed later.
EXPORT_MAX_ROWS=200000
# Maximum reporting-period span in days (default 400 — just over a
# financial year, so a full-FY export always fits).
EXPORT_MAX_RANGE_DAYS=400
# Maximum generated file size in bytes (default 104857600 = 100 MiB).
# Checked before the artifact is persisted to storage.
EXPORT_MAX_FILE_BYTES=104857600
# Maximum exports rendering concurrently in one process (default 3).
# Further requests are refused with a retryable error rather than queued
# invisibly.
EXPORT_MAX_CONCURRENT=3
# Maximum wall-clock seconds one export may spend rendering (default 300).
EXPORT_MAX_EXECUTION_SECONDS=300
